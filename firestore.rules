rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /chess_accounts/{accountId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.resource.data.user_id == request.auth.uid ||
        resource.data.user_id == request.auth.uid
      );
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    match /game_analysis/{analysisId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /move_analysis/{moveId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /import_jobs/{jobId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.user_id == request.auth.uid
      );
    }
  }
}